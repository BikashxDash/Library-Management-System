# Backend Environment Variables

# --- Server ---
PORT=5000

# --- Database (PostgreSQL) ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=library_db
DB_PASSWORD=your_db_password_here
DB_PORT=5432

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_string

# --- Seed admin (used by seed.js) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme_strong_password

# --- Business rules ---
# Fine amount charged per late day (in rupees)
FINE_PER_DAY=5

